{
  "name": "freecall-signaling",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "freecall-test"
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "FreeCallHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FreeCallHub"] }
  ]
}
